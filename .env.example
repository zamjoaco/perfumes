# Copiá este archivo a `.env` (ignorado por git) y completá los valores.
# Lo leen `docker compose` y Spring Boot (spring.config.import en application.yml).
# RESPALDÁ ESTE ARCHIVO junto con los backups de la base: sin DB_PASSWORD no se puede abrir el volumen.

# Postgres
DB_PASSWORD=cambiame

# Único usuario de la app, creado al arrancar si la tabla está vacía
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=cambiame
# Si te olvidaste la contraseña: poné true, arrancá la app (rehashea desde APP_ADMIN_PASSWORD) y volvé a false
APP_ADMIN_RESET_PASSWORD=false

# Secret HS256 para JWT: mínimo 32 caracteres. Generar con:
#   openssl rand -base64 48
APP_JWT_SECRET=
